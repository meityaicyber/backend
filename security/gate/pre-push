#!/bin/sh

echo "==========================================================="
echo "Executing Pre-Push Security Gate (Local Offline Workflow)"
echo "==========================================================="

# Ensure we're at the repo root
cd "$(git rev-parse --show-toplevel)"

# Execute the orchestrator
if [ -f "venv/Scripts/python.exe" ]; then
    PYTHON_CMD="venv/Scripts/python.exe"
elif [ -f "venv/bin/python" ]; then
    PYTHON_CMD="venv/bin/python"
else
    PYTHON_CMD="python"
fi

$PYTHON_CMD security/gate/security_gate.py
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo "==========================================================="
    echo "❌ SECURITY GATE FAILED: Push aborted."
    echo "Please fix the unresolved CRITICAL/HIGH issues or accept the"
    echo "risk by adding them to security/false-positives.md"
    echo "==========================================================="
    exit 1
fi

echo "==========================================================="
echo "✅ SECURITY GATE PASSED: Push allowed."
echo "==========================================================="
exit 0
